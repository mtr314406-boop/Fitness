# Copy to .env and fill in. Never commit .env.

# Your timezone — servers run on UTC, which flips "today"/"tomorrow"
# in the evening without this.
TZ=America/Denver

# Postgres (reuse your OS Postgres, or a fresh Render Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/fitness

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Hevy (hevy.com/settings?developer — requires PRO)
HEVY_API_KEY=

# WHOOP (developer.whoop.com — create an app)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/auth/whoop/callback
